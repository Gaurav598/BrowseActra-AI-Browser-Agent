{
  "name": "browseactra-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "BrowseActra — AI Browser Agent & Automation Platform workspace",
  "homepage": "https://github.com/Gaurav598/BrowseActra-AI-Browser-Agent",
  "bugs": {
    "url": "https://github.com/Gaurav598/BrowseActra-AI-Browser-Agent/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaurav598/BrowseActra-AI-Browser-Agent.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir apps/api dev",
    "dev:api": "pnpm --dir apps/api dev",
    "build:browseactra": "pnpm --dir packages/browseactra-sdk build && pnpm --dir packages/browseactra-cli build && pnpm --dir apps/api build",
    "browseactra": "node packages/browseactra-cli/dist/cli.js",
    "test:browseactra": "pnpm --dir packages/browseactra-runtime test && pnpm --dir packages/browseactra-verifier test && pnpm --dir packages/browseactra-executor test && pnpm --dir packages/browseactra-sdk test && pnpm --dir apps/api test",
    "typecheck:browseactra": "pnpm --dir packages/browseactra-runtime typecheck && pnpm --dir packages/browseactra-verifier typecheck && pnpm --dir packages/browseactra-executor typecheck && pnpm --dir packages/browseactra-sdk typecheck && pnpm --dir packages/browseactra-cli typecheck && pnpm --dir apps/api typecheck",
    "brand:check": "node scripts/brand-check.mjs",
    "check": "turbo run fmt:check lint typecheck",
    "docs": "pnpm --filter ./packages/docs dev",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "turbo run test:unit test:browser",
    "test:unit": "vitest run rules/ast-grep scripts",
    "test:integration": "tsx scripts/test-integration.ts",
    "typecheck": "tsc --noEmit -p tsconfig.tooling.json",
    "build": "turbo run build",
    "build:cli": "turbo run build:cli",
    "generate:python": "uv --directory packages/sdk-python run --locked python scripts/generate.py",
    "generate:go": "go -C packages/sdk-go generate ./...",
    "build:wheel": "uv --directory packages/sdk-python run --locked python scripts/build.py"
  },
  "devDependencies": {
    "@ast-grep/lang-go": "catalog:",
    "@ast-grep/lang-python": "catalog:",
    "@ast-grep/napi": "catalog:",
    "@changesets/apply-release-plan": "catalog:",
    "@changesets/assemble-release-plan": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@changesets/config": "catalog:",
    "@changesets/parse": "0.4.3",
    "@changesets/read": "catalog:",
    "@manypkg/get-packages": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-trace-web": "catalog:",
    "@oxlint/plugins": "1.68.0",
    "@types/chrome": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "openai": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "smol-toml": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.8.10",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
